[package]
name = "yamuse"
version = "0.3.2"
edition = "2024"
rust-version = "1.85"
license = "MIT"
description = "typed async client for the yandex music api: catalogue, likes, playlists, radio, lossless downloads and ynison realtime"
repository = "https://github.com/flxxxxddd/yamuse"
homepage = "https://github.com/flxxxxddd/yamuse"
documentation = "https://docs.rs/yamuse"
readme = "README.md"
keywords = ["yandex", "music", "api", "client", "async"]
categories = ["api-bindings", "multimedia::audio", "asynchronous"]
exclude = [".github/", ".claude/", "docs/", "tests/fixtures/*.bin"]

[features]
default = ["rustls-tls", "download"]

# tls backends — pick exactly one
rustls-tls = ["reqwest/rustls-tls"]
native-tls = ["reqwest/native-tls"]

# stream downloads straight to disk (pulls in tokio fs/io)
download = ["tokio/fs", "tokio/io-util", "dep:futures-util"]

# ynison realtime player state over websocket.
# needs tokio's macros (select!) and rt (spawn), which the base build does not pull in.
realtime = [
    "dep:tokio-tungstenite",
    "dep:futures-util",
    "dep:uuid",
    "tokio/macros",
    "tokio/rt",
]

# emit `tracing` events for requests, retries, rate limits and ynison reconnects
tracing = ["dep:tracing"]

full = ["download", "realtime", "tracing"]

[dependencies]
reqwest = { version = "0.12", default-features = false, features = [
    "json",
    "stream",
    "charset",
    "http2",
] }
tokio = { version = "1", default-features = false, features = ["time", "sync"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
hmac = "0.12"
sha2 = "0.10"
md-5 = "0.10"
base64 = "0.22"
hex = "0.4"
aes = "0.8"
ctr = "0.9"
rand = "0.9"

futures-util = { version = "0.3", default-features = false, features = [
    "std",
], optional = true }
tokio-tungstenite = { version = "0.28", default-features = false, features = [
    "connect",
    "rustls-tls-webpki-roots",
], optional = true }
uuid = { version = "1", features = ["v4"], optional = true }
tracing = { version = "0.1", default-features = false, features = [
    "std",
], optional = true }
serde_path_to_error = "0.1"

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time", "fs"] }
wiremock = "0.6"
tempfile = "3"

# the download integration test needs the feature it tests, so a
# `--no-default-features` run skips it instead of failing to compile.
[[test]]
name = "download"
required-features = ["download"]

[[test]]
name = "transport"

# two examples need an optional feature; declaring it keeps a bare `cargo test`
# from trying to build them.
[[example]]
name = "download"
required-features = ["download"]

[[example]]
name = "now_playing"
required-features = ["realtime"]

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[lints.rust]
missing_docs = "warn"
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
module_name_repetitions = "allow"
missing_errors_doc = "allow"
must_use_candidate = "allow"
struct_excessive_bools = "allow"
too_many_arguments = "allow"
doc_markdown = "allow"
